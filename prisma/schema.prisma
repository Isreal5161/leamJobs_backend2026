generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role     @default(SEEKER)
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seekerProfile   SeekerProfile?
  employerProfile EmployerProfile?
  employerVerification EmployerVerification?
  reviewedEmployerVerifications EmployerVerification[] @relation("EmployerVerificationReviewers")

  jobs             Job[]         @relation("EmployerJobs")
  reviewedJobs     Job[]         @relation("JobReviewers")
  applications     Application[] @relation("SeekerApplications")
  seekerConversations   Conversation[] @relation("SeekerConversations")
  employerConversations Conversation[] @relation("EmployerConversations")
  sentInvitations JobInvitation[] @relation("EmployerInvitations")
  receivedInvitations JobInvitation[] @relation("SeekerInvitations")
  sentMessages          Message[] @relation("MessageSenders")
  subscriptions    Subscription[]
  payments         Payment[]

  employerContracts Contract[] @relation("EmployerContracts")
  seekerContracts   Contract[] @relation("SeekerContracts")

  wallet           Wallet?
  payoutAccounts   PayoutAccount[]
  withdrawals      Withdrawal[] @relation("SeekerWithdrawals")
  payoutRecipients Payout[]     @relation("PayoutRecipients")

  openedDisputes   Dispute[] @relation("DisputeOpeners")
  resolvedDisputes Dispute[] @relation("DisputeResolvers")

  auditLogs FinancialAuditLog[] @relation("FinancialAuditActors")
  notificationsReceived Notification[] @relation("NotificationRecipients")
  notificationsTriggered Notification[] @relation("NotificationActors")
  emailDeliveries EmailDelivery[]
  passwordResetTokens PasswordResetToken[]
  marketingEmailsEnabled Boolean @default(false)
  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")
  emailCampaigns EmailCampaign[] @relation("EmailCampaignCreatedBy")

  @@index([role])
}

model SubscriptionPlan {
  id            String          @id @default(uuid())
  key           String          @unique
  displayName   String
  description   String?
  price         Decimal?        @db.Decimal(12, 2)
  currency      String?         @db.VarChar(3)
  billingInterval BillingInterval @default(MONTHLY)
  isActive      Boolean         @default(true)
  isPublic      Boolean         @default(true)
  displayOrder  Int             @default(0)
  benefits      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subscriptions Subscription[]
  entitlements  PlanEntitlement[]

  @@index([isActive, isPublic, displayOrder])
}

model Entitlement {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PlanEntitlement[]
}

model PlanEntitlement {
  planId        String
  entitlementId String
  createdAt     DateTime @default(now())

  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement Entitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementId])
  @@index([entitlementId])
}

model SiteContent {
  id        String   @id @default(uuid())
  pageKey   String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id               String              @id @default(uuid())
  recipientUserId  String
  actorUserId      String?
  type             NotificationType    @default(INFO)
  category         NotificationCategory @default(GENERAL)
  eventKey         String
  title            String
  message          String
  link             String?
  metadata         Json?
  isRead           Boolean             @default(false)
  readAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  recipient User @relation("NotificationRecipients", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActors", fields: [actorUserId], references: [id], onDelete: SetNull)
  emailDeliveries EmailDelivery[]

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, isRead, createdAt])
  @@index([recipientUserId, createdAt])
}

model EmailDelivery {
  id               String             @id @default(uuid())
  recipientUserId  String?
  publicSubscriberId String?
  notificationId   String?
  emailType        String
  eventKey         String
  recipientEmail   String
  subject          String
  html              String
  text             String
  status           EmailDeliveryStatus @default(PENDING)
  attempts         Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  sentAt           DateTime?
  lastError        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  recipient User? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  publicSubscriber PublicJobSubscriber? @relation(fields: [publicSubscriberId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([recipientUserId, emailType, eventKey])
  @@unique([publicSubscriberId, emailType, eventKey])
  @@index([status, nextAttemptAt])
  @@index([recipientUserId, createdAt])
}

model PublicJobSubscriber {
  id             String   @id @default(uuid())
  email          String   @unique
  unsubscribeHash String  @unique
  isSubscribed   Boolean  @default(true)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  emailDeliveries EmailDelivery[]
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  kind        EmailTemplateKind
  subject     String
  heading     String
  body        String
  ctaLabel    String?
  ctaUrl      String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([kind, isActive])
}

model EmailCampaign {
  id          String              @id @default(uuid())
  eventKey    String              @unique
  subject     String
  heading     String
  body        String
  ctaLabel    String?
  ctaUrl      String?
  segment     EmailCampaignSegment
  status      EmailCampaignStatus @default(DRAFT)
  recipientCount Int?
  createdById String
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  createdBy User @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model SeekerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  professionalTitle String?
  bio               String?
  country           String?
  state             String?
  city              String?
  location          String?
  skills            String[] @default([])
  education         Json?
  experience        Json?
  certifications    Json?
  languages         Json?
  projects          Json?
  cvTemplate        String?
  linkedinUrl       String?
  resumeUrl         String?
  resumeObjectKey   String?
  profilePictureUrl String?
  profilePictureKey String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
}

model EmployerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyName       String
  companyDescription String?
  website           String?
  industry          String?
  companySize       String?
  location          String?
  address           String?
  state             String?
  country           String?
  linkedinUrl       String?
  twitterUrl        String?
  facebookUrl       String?
  companyLogoUrl    String?
  companyLogoKey    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
  @@index([industry])
}

model EmployerVerification {
  id              String                      @id @default(uuid())
  userId          String                      @unique
  status          EmployerVerificationStatus  @default(PENDING)
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  declineReason   String?
  registrationNumber String?
  registrationType   String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("EmployerVerificationReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents EmployerVerificationDocument[]

  @@index([status, submittedAt])
  @@index([reviewedById, reviewedAt])
}

model EmployerVerificationDocument {
  id             String                              @id @default(uuid())
  verificationId String
  kind           EmployerVerificationDocumentKind
  fileName       String
  contentType    String
  fileSize       Int?
  objectKey      String
  uploadedAt     DateTime                            @default(now())
  createdAt      DateTime                            @default(now())

  verification EmployerVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, uploadedAt])
}

model Job {
  id                  String     @id @default(uuid())
  employerId          String
  title               String
  description         String
  location            String
  jobType             JobType
  engagementType      EngagementType @default(MONTHLY)
  skills              String[]   @default([])
  requirements        Json?
  responsibilities    String[]   @default([])
  benefits            String[]   @default([])
  department          String?
  workArrangement     WorkArrangement?
  status              JobStatus  @default(PENDING)
  applicationDeadline DateTime?
  rejectionReason     String?
  reviewedById        String?
  reviewedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  employer                User                    @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Restrict)
  reviewedBy              User?                   @relation("JobReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)
  applications            Application[]
  contracts               Contract[]
  conversations           Conversation[]
  invitations             JobInvitation[]
  employmentCompensation  EmploymentCompensation?
  contractCompensation    ContractCompensation?
  freelanceCompensation   FreelanceCompensation?

  @@index([employerId, createdAt])
  @@index([status, createdAt])
  @@index([status, location, createdAt])
  @@index([status, jobType, createdAt])
}

model EmploymentCompensation {
  id           String       @id @default(uuid())
  jobId        String       @unique
  salaryMin    Decimal?     @db.Decimal(12, 2)
  salaryMax    Decimal?     @db.Decimal(12, 2)
  currency     String       @default("NGN") @db.VarChar(3)
  salaryPeriod SalaryPeriod @default(MONTHLY)

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model FreelanceCompensation {
  id            String  @id @default(uuid())
  jobId         String  @unique
  projectAmount Decimal @db.Decimal(12, 2)
  currency      String  @default("NGN") @db.VarChar(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model ContractCompensation {
  id       String  @id @default(uuid())
  jobId    String  @unique
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN") @db.VarChar(3)
  duration String?
  startMode              ContractStartMode @default(IMMEDIATE)
  scheduledStartDate     DateTime?
  expectedCompletionDate  DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model Application {
  id                String            @id @default(uuid())
  seekerId          String
  jobId             String
  coverLetter       String?
  resumeUrl         String?
  resumeObjectKey   String?
  resumeVersion     String?
  resumeSubmittedAt DateTime          @default(now())
  status            ApplicationStatus @default(APPLIED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  seeker      User                  @relation("SeekerApplications", fields: [seekerId], references: [id], onDelete: Restrict)
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  contract    Contract?
  conversation Conversation?
  invitation  JobInvitation?
  cvSnapshot  ApplicationCvSnapshot?

  @@unique([seekerId, jobId])
  @@index([seekerId, createdAt])
  @@index([jobId, createdAt])
}

enum JobInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model JobInvitation {
  id           String              @id @default(uuid())
  employerId   String
  seekerId     String
  jobId        String
  message      String
  status       JobInvitationStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  respondedAt  DateTime?
  expiresAt    DateTime?
  conversationId String?           @unique
  applicationId  String?           @unique

  employer     User         @relation("EmployerInvitations", fields: [employerId], references: [id], onDelete: Restrict)
  seeker       User         @relation("SeekerInvitations", fields: [seekerId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([employerId, seekerId, jobId, status])
  @@index([seekerId, status, createdAt])
  @@index([employerId, status, createdAt])
  @@index([jobId, status])
}

enum CvSource {
  LEAMJOBS_TEMPLATE
}

model ApplicationCvSnapshot {
  id                 String   @id @default(uuid())
  applicationId      String   @unique
  source             CvSource @default(LEAMJOBS_TEMPLATE)
  templateId         String?
  templateName       String?
  templateVersion    String?
  snapshotCapturedAt  DateTime @default(now())
  snapshot           Json     @db.JsonB
  createdAt          DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String   @id @default(uuid())
  seekerId      String
  employerId    String
  jobId         String?
  applicationId String?  @unique
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seeker      User         @relation("SeekerConversations", fields: [seekerId], references: [id], onDelete: Cascade)
  employer    User         @relation("EmployerConversations", fields: [employerId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invitation JobInvitation?
  messages    Message[]

  @@index([seekerId, lastMessageAt])
  @@index([employerId, lastMessageAt])
  @@index([jobId, lastMessageAt])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  senderId        String
  body            String
  clientMessageId String?
  createdAt       DateTime     @default(now())
  readAt          DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSenders", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([conversationId, readAt])
}

model Contract {
  id                 String         @id @default(uuid())
  applicationId      String         @unique
  jobId              String
  employerId         String
  seekerId           String
  type               ContractType
  status             ContractStatus @default(PENDING)
  startDate          DateTime?
  expectedEndDate    DateTime?
  completedAt        DateTime?
  endedAt            DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  employer    User        @relation("EmployerContracts", fields: [employerId], references: [id], onDelete: Restrict)
  seeker      User        @relation("SeekerContracts", fields: [seekerId], references: [id], onDelete: Restrict)

  freelanceDetails FreelanceContract?
  disputes         Dispute[]
  ledgerEntries    FinancialLedgerEntry[]

  @@index([employerId, status])
  @@index([seekerId, status])
  @@index([jobId])
  @@index([status, createdAt])
}

model FreelanceContract {
  id                     String              @id @default(uuid())
  contractId             String              @unique
  agreedAmount           Decimal             @db.Decimal(12, 2)
  currency               String              @db.VarChar(3)
  duration               String?
  startMode              ContractStartMode?
  platformFeePercentage  Decimal?            @db.Decimal(5, 2)
  platformFeeAmount      Decimal?            @db.Decimal(12, 2)
  seekerNetAmount        Decimal?            @db.Decimal(12, 2)
  expectedCompletionDate DateTime?
  workStatus             FreelanceWorkStatus @default(PENDING)
  completionSubmittedAt  DateTime?
  completionNote         String?
  employerConfirmedAt    DateTime?
  seekerConfirmedAt      DateTime?
  employerCompletionConfirmedAt DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  escrow   Escrow?

  @@index([workStatus, expectedCompletionDate])
}

model PlatformFeeConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique @default("default")
  percentage Decimal @db.Decimal(5, 2) @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escrow {
  id                  String       @id @default(uuid())
  freelanceContractId String       @unique
  grossAmount         Decimal      @db.Decimal(12, 2)
  platformFeeAmount   Decimal      @default(0) @db.Decimal(12, 2)
  seekerNetAmount     Decimal      @db.Decimal(12, 2)
  currency            String       @db.VarChar(3)
  fundedAmount        Decimal      @default(0) @db.Decimal(12, 2)
  releasedAmount      Decimal      @default(0) @db.Decimal(12, 2)
  refundedAmount      Decimal      @default(0) @db.Decimal(12, 2)
  status              EscrowStatus @default(UNFUNDED)
  fundedAt            DateTime?
  releaseEligibleAt   DateTime?
  releasedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  freelanceContract FreelanceContract  @relation(fields: [freelanceContractId], references: [contractId], onDelete: Restrict)
  payments          Payment[]
  refunds           Refund[]
  disputes          Dispute[]
  ledgerEntries     FinancialLedgerEntry[]

  @@index([status, createdAt])
  @@index([status, fundedAt])
}

model Subscription {
  id                        String             @id @default(uuid())
  userId                    String
  planId                    String
  status                    SubscriptionStatus @default(PENDING)
  priceSnapshot             Decimal?           @db.Decimal(12, 2)
  currencySnapshot         String?            @db.VarChar(3)
  billingIntervalSnapshot  BillingInterval?
  startDate                 DateTime?
  endDate                   DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  nextRenewalAt             DateTime?
  providerCustomerReference String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  events   SubscriptionEvent[]

  @@index([userId, status])
  @@index([planId, status])
  @@index([status, endDate])
}

model SubscriptionEvent {
  id                String                @id @default(uuid())
  subscriptionId    String
  eventType         SubscriptionEventType
  providerReference String?
  metadata          Json?
  occurredAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, occurredAt])
  @@index([eventType, occurredAt])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  escrowId          String?
  providerReference String        @unique
  transactionId     String?       @unique
  idempotencyKey    String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paymentType       PaymentType
  provider          PaymentProvider
  metadata          Json?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  escrow       Escrow?       @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  refunds      Refund[]
  ledgerEntries FinancialLedgerEntry[]

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([escrowId])
  @@index([status, createdAt])
}

model Wallet {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  currency                 String   @default("NGN") @db.VarChar(3)
  availableBalance         Decimal  @default(0) @db.Decimal(12, 2)
  pendingWithdrawalBalance Decimal  @default(0) @db.Decimal(12, 2)
  version                  Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries FinancialLedgerEntry[]
  withdrawals   Withdrawal[]
}

model FinancialLedgerEntry {
  id             String           @id @default(uuid())
  entryType      LedgerEntryType
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @db.VarChar(3)
  balanceAfter   Decimal?         @db.Decimal(12, 2)
  idempotencyKey String           @unique
  description    String?
  walletId       String?
  contractId     String?
  escrowId       String?
  paymentId      String?
  withdrawalId   String?
  payoutId       String?
  refundId       String?
  createdAt      DateTime         @default(now())

  wallet     Wallet?     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  contract   Contract?   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  escrow     Escrow?     @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  payout     Payout?     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  refund     Refund?     @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([contractId, createdAt])
  @@index([escrowId, createdAt])
  @@index([withdrawalId])
  @@index([entryType, createdAt])
}

model PayoutAccount {
  id                     String          @id @default(uuid())
  userId                 String
  provider               PaymentProvider
  payoutMethod           PayoutMethod
  country                String
  currency               String          @db.VarChar(3)
  bankCode               String?
  bankName               String?
  encryptedAccountNumber String
  accountNumberLast4     String
  accountName            String
  isDefault              Boolean         @default(false)
  verifiedAt             DateTime?
  disabledAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@index([userId, isDefault])
  @@index([userId, disabledAt])
}

model Withdrawal {
  id                String           @id @default(uuid())
  walletId          String
  seekerId          String
  payoutAccountId   String
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @db.VarChar(3)
  status            WithdrawalStatus @default(PENDING)
  idempotencyKey    String           @unique
  provider          PaymentProvider?
  providerReference String?          @unique
  requestedAt       DateTime         @default(now())
  processingAt      DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  seeker        User         @relation("SeekerWithdrawals", fields: [seekerId], references: [id], onDelete: Restrict)
  payoutAccount PayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  payout        Payout?
  ledgerEntries FinancialLedgerEntry[]

  @@index([seekerId, createdAt])
  @@index([walletId, status])
  @@index([status, createdAt])
}

model Payout {
  id                String        @id @default(uuid())
  withdrawalId      String        @unique
  recipientUserId   String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  provider          PaymentProvider
  providerReference String?       @unique
  status            PayoutStatus  @default(PENDING)
  requestedAt       DateTime      @default(now())
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  withdrawal   Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  recipient    User       @relation("PayoutRecipients", fields: [recipientUserId], references: [id], onDelete: Restrict)
  attempts     PayoutAttempt[]
  ledgerEntries FinancialLedgerEntry[]

  @@index([recipientUserId, createdAt])
  @@index([status, createdAt])
}

model PayoutAttempt {
  id                String             @id @default(uuid())
  payoutId          String
  attemptNumber     Int
  providerReference String?            @unique
  status            PayoutAttemptStatus @default(PENDING)
  failureReason     String?
  createdAt         DateTime           @default(now())
  processedAt       DateTime?

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, attemptNumber])
  @@index([payoutId, createdAt])
  @@index([status, createdAt])
}

model Refund {
  id                String        @id @default(uuid())
  escrowId          String
  paymentId         String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  provider          PaymentProvider
  providerReference String?       @unique
  status            RefundStatus  @default(PENDING)
  reason            String?
  requestedAt       DateTime      @default(now())
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  escrow       Escrow                 @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  payment      Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  ledgerEntries FinancialLedgerEntry[]
}

model Dispute {
  id             String        @id @default(uuid())
  contractId     String
  escrowId       String
  openedByUserId String
  resolvedById   String?
  status         DisputeStatus @default(OPEN)
  reason         String
  resolutionNote String?
  openedAt       DateTime      @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  escrow     Escrow   @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  openedBy   User     @relation("DisputeOpeners", fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("DisputeResolvers", fields: [resolvedById], references: [id], onDelete: SetNull)
}

model FinancialAuditLog {
  id          String               @id @default(uuid())
  actorUserId String?
  entityType  FinancialEntityType
  entityId    String
  action      FinancialAction
  fromStatus  String?
  toStatus    String?
  amount      Decimal?             @db.Decimal(12, 2)
  currency    String?              @db.VarChar(3)
  reason      String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  actor User? @relation("FinancialAuditActors", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model ProviderWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String?
  payloadHash     String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, createdAt])
}

