NODE_ENV=development
PORT=5000
HOST=localhost
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/leamjobs"
JWT_SECRET=change_me
JWT_EXPIRE=24h
JWT_ISSUER=leamjobs-development
JWT_AUDIENCE=leamjobs-api

# Namecheap Private Email. Keep disabled until production credentials are configured.
EMAIL_ENABLED=false
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@leamjobs.com
EMAIL_FROM_NAME=LeamJobs
EMAIL_REPLY_TO=support@leamjobs.com
PASSWORD_RESET_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://leamjobs.com

# Paystack outbound transfers (server-side only; never expose to frontend)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
