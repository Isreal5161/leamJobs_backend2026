NODE_ENV=development
PORT=5000
HOST=localhost
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/leamjobs"
JWT_SECRET=change_me
JWT_EXPIRE=24h
JWT_ISSUER=leamjobs-development
JWT_AUDIENCE=leamjobs-api

# Namecheap Private Email. Keep disabled until production credentials are configured.
EMAIL_ENABLED=false
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@leamjobs.com
EMAIL_FROM_NAME=LeamJobs
EMAIL_REPLY_TO=support@leamjobs.com
PASSWORD_RESET_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://leamjobs.com

# Server-controlled current versions required for new account legal acceptance
TERMS_DOCUMENT_VERSION=1.0-draft
PRIVACY_DOCUMENT_VERSION=1.0-draft

# Flutterwave payments and webhook verification (server-side only)
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Paystack transfers and contract-funding collection (server-side only; never expose to frontend)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_COLLECTION_ENABLED=false
# Public backend URL for Paystack contract-funding returns, e.g. https://api.leamjobs.com/api/payments/paystack/contract-return
PAYSTACK_CONTRACT_CALLBACK_URL=

# Nigerian USD domiciliary payout remitter details must come from the approved Flutterwave
# merchant/KYC identity. Leave blank until supplied from that authorized source.
FLUTTERWAVE_DOM_REMITTER_NAME=
FLUTTERWAVE_DOM_REMITTER_ADDRESS=
FLUTTERWAVE_DOM_REMITTER_CITY=
FLUTTERWAVE_DOM_REMITTER_COUNTRY=
FLUTTERWAVE_DOM_REMITTER_ID_NUMBER=
FLUTTERWAVE_DOM_REMITTER_ID_TYPE=
FLUTTERWAVE_DOM_REMITTER_ID_EXPIRY=
FLUTTERWAVE_DOM_REMITTER_MOBILE_NUMBER=
FLUTTERWAVE_DOM_REMITTER_EMAIL=
FLUTTERWAVE_DOM_REMITTER_OCCUPATION=
FLUTTERWAVE_DOM_REMITTER_BENEFICIARY_RELATIONSHIP=

# Freelance financial operations are fail-closed unless explicitly enabled.
LEAMJOBS_FREELANCE_PAYMENTS_ENABLED=false
LEAMJOBS_FREELANCE_CONTRACT_FUNDING_ENABLED=false
LEAMJOBS_FREELANCE_ESCROW_RELEASE_ENABLED=false
LEAMJOBS_FREELANCE_WITHDRAWALS_ENABLED=false
LEAMJOBS_FREELANCE_USD_WITHDRAWALS_ENABLED=false
